# Salin file ini menjadi .env lalu sesuaikan.

# Port dashboard
FLASK_PORT=5000

# Backend LLM untuk eskalasi L4-L5:
#   local  -> transformers zero-shot lokal (default, tanpa internet saat inferensi)
#   ollama -> server Ollama lokal (mis. llama3 / qwen)
LLM_BACKEND=local

# Model zero-shot lokal (dipakai bila LLM_BACKEND=local)
ZS_MODEL=facebook/bart-large-mnli

# Konfigurasi Ollama (dipakai bila LLM_BACKEND=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
